# Share the target Google Sheet with the service account email as an Editor.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Either use a quoted multiline value or replace newlines with \n.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional. The tab must contain columns A through I in the documented order.
GOOGLE_SHEET_RANGE=Leads!A:I

# WhatsApp Configuration (Optional - Defaults to 212522200000)
NEXT_PUBLIC_WHATSAPP_NUMBER=212522200000
NEXT_PUBLIC_WHATSAPP_MESSAGE="Bonjour, j'ai visité votre site web et je souhaite obtenir plus d'informations."
